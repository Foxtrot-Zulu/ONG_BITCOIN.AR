<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>La Minería de Bitcoin</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@300;500;700&display=swap');

    :root {
      --bg:      #080c10;
      --surface: #0f1923;
      --border:  #1e2d3d;
      --orange:  #f7931a;
      --gold:    #e8b84b;
      --teal:    #0ef;
      --text:    #d0dce8;
      --muted:   #5a7185;
      --white:   #f0f6fc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; background: var(--bg); font-family: 'Inter', sans-serif; color: var(--text); overflow: hidden; }

    /* ─── DECK ─── */
    #deck { width: 100%; height: 100vh; position: relative; }
    .slide {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      padding: 2.8rem 5rem;
      opacity: 0; pointer-events: none;
      transition: opacity .5s cubic-bezier(.4,0,.2,1), transform .5s cubic-bezier(.4,0,.2,1);
      transform: translateY(20px);
      text-align: center;
    }
    .slide.active { opacity: 1; pointer-events: all; transform: translateY(0); }

    /* ─── NAV ─── */
    #nav {
      position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 1.2rem; z-index: 100;
      background: rgba(8,12,16,.85); border: 1px solid var(--border);
      padding: .55rem 1.4rem; border-radius: 999px; backdrop-filter: blur(12px);
    }
    #nav button { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1rem; padding: .2rem .5rem; border-radius: 6px; transition: color .2s; font-family: 'Space Mono', monospace; }
    #nav button:hover { color: var(--orange); }
    #counter { font-family: 'Space Mono', monospace; font-size: .72rem; color: var(--muted); min-width: 3.5rem; text-align: center; }
    #axis-label { font-family: 'Space Mono', monospace; font-size: .68rem; color: var(--muted); min-width: 7rem; }
    #progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--orange); transition: width .3s; z-index: 200; }

    /* ─── TYPE ─── */
    .eyebrow { font-family: 'Space Mono', monospace; font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--orange); margin-bottom: 1rem; }
    .eyebrow.teal { color: var(--teal); }
    .eyebrow.gold { color: var(--gold); }
    h1 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(2.6rem,5vw,4.4rem); line-height: 1.05; color: var(--white); letter-spacing: -.02em; }
    h2 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(1.7rem,3vw,2.7rem); line-height: 1.1; color: var(--white); letter-spacing: -.02em; margin-bottom: 1.2rem; }
    .lead { font-size: clamp(.9rem,1.4vw,1.1rem); line-height: 1.7; color: var(--text); max-width: 700px; font-weight: 300; }
    .big-stat { font-family: 'Space Mono', monospace; font-size: clamp(3rem,6vw,5.5rem); color: var(--orange); font-weight: 700; line-height: 1; }
    .big-stat.teal { color: var(--teal); }
    .big-stat.gold { color: var(--gold); }
    .divider { width: 50px; height: 2px; background: var(--orange); margin: 1.1rem auto; }
    .divider.teal { background: var(--teal); }
    .divider.gold { background: var(--gold); }

    /* ─── CARDS ─── */
    .card-grid { display: grid; gap: 1rem; width: 100%; max-width: 900px; margin: 1.2rem 0; }
    .card-grid.cols-2 { grid-template-columns: repeat(2,1fr); }
    .card-grid.cols-3 { grid-template-columns: repeat(3,1fr); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem 1.4rem; text-align: left; position: relative; overflow: hidden; }
    .card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--orange); }
    .card.teal::before { background: var(--teal); }
    .card.gold::before { background: var(--gold); }
    .card-label { font-family: 'Space Mono', monospace; font-size: .62rem; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; margin-bottom: .4rem; }
    .card-value { font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 500; color: var(--white); line-height: 1.4; }
    .card-sub { font-size: .78rem; color: var(--muted); margin-top: .3rem; line-height: 1.5; }

    /* ─── HIGHLIGHT BOX ─── */
    .hl-box { background: rgba(247,147,26,.06); border: 1px solid rgba(247,147,26,.25); border-radius: 10px; padding: 1rem 1.6rem; max-width: 680px; margin: .8rem 0; font-size: 1rem; color: var(--white); line-height: 1.6; }
    .hl-box.teal { background: rgba(0,238,255,.04); border-color: rgba(0,238,255,.2); }
    .hl-box.gold { background: rgba(232,184,75,.05); border-color: rgba(232,184,75,.2); }

    /* ─── AXIS COVER ─── */
    .axis-number { font-family: 'Space Mono', monospace; font-size: clamp(6rem,12vw,12rem); font-weight: 700; line-height: 1; opacity: .07; position: absolute; user-select: none; }

    /* ─── COVER ─── */
    #cover-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at 60% 40%, rgba(247,147,26,.08) 0%, transparent 60%); pointer-events: none; }
    .cover-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--border) 1px,transparent 1px), linear-gradient(90deg,var(--border) 1px,transparent 1px); background-size: 48px 48px; opacity: .2; pointer-events: none; }
    #live-hash { font-family: 'Space Mono', monospace; font-size: .7rem; color: #15304a; word-break: break-all; max-width: 580px; line-height: 1.7; margin: .8rem auto; }
    #live-hash .valid { color: var(--orange); }

    /* ─── BLOCK DIAGRAM ─── */
    .block-diagram { display: flex; align-items: center; gap: .7rem; max-width: 860px; width: 100%; margin: 1rem 0; }
    .block-box { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: .8rem 1rem; text-align: center; flex: 1; }
    .block-box.active-box { border-color: var(--orange); background: rgba(247,147,26,.05); }
    .block-box.active-teal { border-color: var(--teal); background: rgba(0,238,255,.04); }
    .block-box-label { font-family: 'Space Mono', monospace; font-size: .58rem; color: var(--muted); letter-spacing: .1em; text-transform: uppercase; margin-bottom: .25rem; }
    .block-box-val { font-family: 'Space Mono', monospace; font-size: .72rem; color: var(--white); word-break: break-all; }
    .arrow { color: var(--muted); font-size: 1.2rem; flex-shrink: 0; }

    /* ─── TIMELINE ─── */
    .timeline { display: flex; gap: 0; align-items: stretch; width: 100%; max-width: 860px; margin: 1.2rem 0; }
    .tl-item { flex: 1; position: relative; padding-top: 1rem; }
    .tl-item::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--border); }
    .tl-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--orange); border: 2px solid var(--bg); position: absolute; top: -4px; left: 50%; transform: translateX(-50%); }
    .tl-dot.gold { background: var(--gold); }
    .tl-year { font-family: 'Space Mono', monospace; font-size: .72rem; color: var(--orange); margin-bottom: .25rem; }
    .tl-year.gold { color: var(--gold); }
    .tl-label { font-size: .8rem; color: var(--white); font-weight: 500; }
    .tl-sub { font-size: .68rem; color: var(--muted); margin-top: .12rem; }

    /* ─── MERKLE TREE SVG ─── */
    .merkle-wrap { width: 100%; max-width: 820px; margin: .8rem 0; }

    /* ─── POOL TABLE ─── */
    .pool-table { width: 100%; max-width: 780px; border-collapse: collapse; font-size: .8rem; }
    .pool-table th { font-family: 'Space Mono', monospace; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-align: left; padding: .4rem .8rem; border-bottom: 1px solid var(--border); }
    .pool-table td { padding: .45rem .8rem; border-bottom: 1px solid rgba(30,45,61,.5); color: var(--text); }
    .pool-table td:last-child { font-family: 'Space Mono', monospace; color: var(--teal); }
    .pool-bar { height: 4px; border-radius: 2px; background: var(--teal); display: inline-block; vertical-align: middle; margin-left: .5rem; }

    /* ─── HASH DEMO ─── */
    .hash-row { font-family: 'Space Mono', monospace; font-size: .64rem; color: #1e3a52; word-break: break-all; line-height: 1.8; max-width: 720px; }
    .hash-row .hl { color: var(--teal); }
    .hash-row .label { color: var(--muted); display: inline-block; min-width: 100px; }

    /* ─── VERIFICATION EXAMPLE ─── */
    .verify-steps { display: flex; flex-direction: column; gap: .6rem; max-width: 720px; width: 100%; text-align: left; }
    .verify-step { display: flex; gap: 1rem; align-items: flex-start; }
    .step-num { font-family: 'Space Mono', monospace; font-size: .72rem; color: var(--teal); background: rgba(0,238,255,.08); border: 1px solid rgba(0,238,255,.2); border-radius: 6px; padding: .25rem .55rem; flex-shrink: 0; margin-top: .05rem; }
    .step-text { font-size: .88rem; color: var(--text); line-height: 1.55; }
    .step-code { font-family: 'Space Mono', monospace; font-size: .65rem; color: var(--teal); display: block; margin-top: .2rem; word-break: break-all; }

    @media (max-width: 700px) {
      .slide { padding: 1.5rem; }
      .card-grid.cols-3, .card-grid.cols-2 { grid-template-columns: 1fr; }
      .timeline { flex-direction: column; }
      .block-diagram { flex-direction: column; }
    }
  </style>
</head>
<body>
<div id="progress"></div>
<div id="deck">

  <!-- ── 00 COVER ── -->
  <div class="slide active" data-axis="intro">
    <div id="cover-bg"></div><div class="cover-grid"></div>
    <div class="eyebrow">learnmeabitcoin.com · mempool.space · mainnet.observer</div>
    <h1>La Minería<br>de Bitcoin</h1>
    <div id="live-hash">
      <span class="valid">000000000000000000</span>0007768b04a3184a871d1e4bbb71d71f4e8cc9f7e8f99b<br>
      a3c4e2b91f0d5872e6a4c810f3e927b5d6a1c48f2e0b93d7a5f1c628e<br>
      4b9f2e7a1c5d8b0e3f6a9c2d5b8e1f4a7c0d3b6e9f2a5c8d1b4e7f0a3
    </div>
    <div class="divider"></div>
    <p class="lead">Cómo una red de computadoras desconocidas entre sí llega a un acuerdo sobre la verdad, sin ninguna autoridad central — y por qué eso importa.</p>
    <div style="margin-top:1.8rem;display:flex;gap:2rem;font-family:'Space Mono',monospace;font-size:.7rem;color:var(--muted)">
      <span style="color:var(--orange)">■</span><span>Filosófico</span>
      <span style="color:var(--teal)">■</span><span>Técnico</span>
      <span style="color:var(--gold)">■</span><span>Económico</span>
    </div>
    <div style="margin-top:1.2rem;font-family:'Space Mono',monospace;font-size:.65rem;color:var(--muted)">
      Datos al 17/06/2026 · Bloque #952.748 · 858 EH/s · Dificultad 138,96T
    </div>
  </div>

  <!-- ── 01 EL PROBLEMA ── -->
  <div class="slide" data-axis="intro">
    <div class="eyebrow">El problema fundamental</div>
    <h2>El doble gasto digital</h2>
    <div class="card-grid cols-2" style="max-width:740px">
      <div class="card">
        <div class="card-label">Dinero físico</div>
        <div class="card-value">Si te doy un billete, ya no lo tengo</div>
        <div class="card-sub">La escasez es física. No requiere verificación adicional.</div>
      </div>
      <div class="card" style="border-color:rgba(247,147,26,.4);background:rgba(247,147,26,.04)">
        <div class="card-label">Dinero digital</div>
        <div class="card-value">Un archivo puede copiarse y enviarse dos veces</div>
        <div class="card-sub">¿Quién verifica que no hubo duplicado?</div>
      </div>
    </div>
    <div class="hl-box">
      La solución tradicional: un banco como árbitro.<br>La solución de Nakamoto: <strong>matemáticas como árbitro</strong>.
    </div>
  </div>

  <!-- ── 02 COVER FILOSÓFICO ── -->
  <div class="slide" data-axis="filosofico">
    <div class="axis-number" style="color:var(--orange)">I</div>
    <div class="eyebrow">Eje I de III</div>
    <h1 style="font-size:clamp(2.5rem,5vw,4rem)">Filosófico</h1>
    <div class="divider"></div>
    <p class="lead">Por qué existe la minería. Qué problema resuelve. Qué visión del mundo encarna.</p>
    <div style="margin-top:2rem;display:grid;gap:.7rem;font-family:'Space Mono',monospace;font-size:.78rem;color:var(--muted);text-align:left">
      <div>→ El problema de los Generales Bizantinos</div>
      <div>→ Consenso sin autoridad</div>
      <div>→ Proof of Work como filosofía política</div>
    </div>
  </div>

  <!-- ── 03 GENERALES BIZANTINOS ── -->
  <div class="slide" data-axis="filosofico">
    <div class="eyebrow">Ciencias de la computación</div>
    <h2>El problema de los Generales Bizantinos</h2>
    <p class="lead" style="margin-bottom:1.2rem">¿Cómo pueden agentes que no confían entre sí coordinar una acción común, incluso si algunos son traidores?</p>
    <div class="card-grid cols-3">
      <div class="card"><div class="card-label">Enfoque tradicional</div><div class="card-value">Votar</div><div class="card-sub">Requiere identidad verificable. Fácil de manipular con identidades falsas (Sybil attack).</div></div>
      <div class="card"><div class="card-label">Enfoque de Nakamoto</div><div class="card-value">Trabajar</div><div class="card-sub">No votos, no reputación, no identidad. Solo trabajo computacional real e irreversible.</div></div>
      <div class="card"><div class="card-label">La clave</div><div class="card-value">Unforgeable Costliness</div><div class="card-sub">No podés fingir que hiciste el trabajo. Tenés que hacerlo. (Nick Szabo)</div></div>
    </div>
  </div>

  <!-- ── 04 BLOQUE GÉNESIS ── -->
  <div class="slide" data-axis="filosofico">
    <div class="eyebrow">3 de enero, 2009</div>
    <h2>El bloque génesis</h2>
    <div class="hl-box" style="font-family:'Space Mono',monospace;font-size:1.1rem;margin-bottom:1.2rem">
      "The Times 03/Jan/2009<br>Chancellor on brink of second bailout for banks"
    </div>
    <p class="lead" style="max-width:640px">Satoshi embebió este titular en el primer bloque de Bitcoin. Los bancos que causaron la crisis de 2008 eran rescatados con dinero público mientras Bitcoin nacía como alternativa.</p>
    <div style="margin-top:1.4rem;font-family:'Space Mono',monospace;font-size:.68rem;color:var(--muted)">
      Block #0 · 000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f
    </div>
  </div>

  <!-- ── 05 DESCENTRALIZACIÓN ── -->
  <div class="slide" data-axis="filosofico">
    <div class="eyebrow">La propuesta política</div>
    <h2>Dinero sin permiso</h2>
    <div class="card-grid cols-2" style="max-width:760px">
      <div class="card" style="border-top-color:var(--muted)">
        <div class="card-label">Sistema actual</div>
        <div class="card-value">El banco central imprime → tus ahorros se diluyen</div>
        <div class="card-sub">Un gobierno congela cuentas. Una empresa bloquea pagos. El árbitro tiene poder discrecional sobre tu dinero.</div>
      </div>
      <div class="card">
        <div class="card-label">La propuesta de Bitcoin</div>
        <div class="card-value">Las reglas son matemáticas. No hay árbitro.</div>
        <div class="card-sub">Nadie puede cambiar las reglas sin convencer a la mayoría de la red. Nadie puede confiscar lo que la matemática protege.</div>
      </div>
    </div>
    <p class="lead" style="margin-top:1rem">La minería es la implementación técnica de este principio: el consenso se gana con trabajo, no con poder.</p>
  </div>

  <!-- ── 06 COVER TÉCNICO ── -->
  <div class="slide" data-axis="tecnico">
    <div class="axis-number" style="color:var(--teal)">II</div>
    <div class="eyebrow teal">Eje II de III</div>
    <h1 style="font-size:clamp(2.5rem,5vw,4rem);color:var(--teal)">Técnico</h1>
    <div class="divider teal"></div>
    <p class="lead">Cómo funciona exactamente la minería, hasta el nivel del bit y el byte.</p>
    <div style="margin-top:2rem;display:grid;gap:.7rem;font-family:'Space Mono',monospace;font-size:.78rem;color:var(--muted);text-align:left">
      <div>→ Mempool → Bloque candidato → Blockchain</div>
      <div>→ Árbol de Merkle · SHA-256 · Por qué es unidireccional</div>
      <div>→ Proof of Work · Target · Validación con ejemplo real</div>
    </div>
  </div>

  <!-- ── 07 MEMPOOL ── -->
  <div class="slide" data-axis="tecnico">
    <div class="eyebrow teal">Paso 1</div>
    <h2>La mempool: sala de espera</h2>
    <div class="block-diagram">
      <div class="block-box active-teal"><div class="block-box-label">Usuario envía BTC</div><div class="block-box-val" style="color:var(--teal)">TX broadcast</div></div>
      <div class="arrow">→</div>
      <div class="block-box active-teal"><div class="block-box-label">Memory Pool</div><div class="block-box-val" style="color:var(--teal)">TX pendientes</div></div>
      <div class="arrow">→</div>
      <div class="block-box"><div class="block-box-label">Minero selecciona</div><div class="block-box-val">Bloque candidato</div></div>
      <div class="arrow">→</div>
      <div class="block-box"><div class="block-box-label">Blockchain</div><div class="block-box-val">Permanente</div></div>
    </div>
    <div class="card-grid cols-2" style="max-width:700px">
      <div class="card teal"><div class="card-label">Mempool</div><div class="card-value">Transacciones "flotantes"</div><div class="card-sub">Temporales, no confirmadas. Cada nodo mantiene su propia copia.</div></div>
      <div class="card teal"><div class="card-label">Blockchain</div><div class="card-value">Transacciones "archivadas"</div><div class="card-sub">Permanentes, inmutables, verificables por cualquiera.</div></div>
    </div>
  </div>

  <!-- ── 08 BLOQUE CANDIDATO ── -->
  <div class="slide" data-axis="tecnico">
    <div class="eyebrow teal">Paso 2</div>
    <h2>El bloque candidato</h2>
    <div class="card-grid cols-2" style="max-width:800px">
      <div class="card teal"><div class="card-label">Cuerpo del bloque</div><div class="card-value">Lista de transacciones</div><div class="card-sub">El minero elige qué TXs incluir. Las de mayor comisión primero.</div></div>
      <div class="card teal" style="grid-row:span 2">
        <div class="card-label">Header — 80 bytes exactos</div>
        <div style="display:grid;gap:.6rem;margin-top:.5rem">
          <div><div style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--teal)">VERSION (4B)</div><div class="card-sub">Versión del protocolo</div></div>
          <div><div style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--teal)">PREV BLOCK HASH (32B)</div><div class="card-sub">Apunta al bloque anterior → forma la cadena</div></div>
          <div><div style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--teal)">MERKLE ROOT (32B)</div><div class="card-sub">Resumen hash de todas las TXs</div></div>
          <div><div style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--teal)">TIME (4B) · BITS (4B)</div><div class="card-sub">Timestamp y dificultad codificada</div></div>
          <div><div style="font-family:'Space Mono',monospace;font-size:.62rem;color:var(--orange)">NONCE (4B) ← el que el minero itera</div><div class="card-sub">0 a 4.294.967.295</div></div>
        </div>
      </div>
      <div class="card teal"><div class="card-label">Merkle Root</div><div class="card-value">Árbol binario de hashes</div><div class="card-sub">Un único número de 32 bytes resume criptográficamente todas las transacciones del bloque. Ver siguiente slide →</div></div>
    </div>
  </div>

  <!-- ── 09 ÁRBOL DE MERKLE (SVG) ── -->
  <div class="slide" data-axis="tecnico">
    <div class="eyebrow teal">El árbol de Merkle</div>
    <h2>Cómo se construye el Merkle Root</h2>
    <div class="merkle-wrap">
      <svg viewBox="0 0 820 340" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-height:280px">
        <defs>
          <filter id="glow"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <!-- LEVEL 0: Transactions -->
        <g font-family="Space Mono, monospace" font-size="9" fill="#5a7185">
          <!-- TX boxes -->
          <rect x="20"  y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d"/>
          <rect x="160" y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d"/>
          <rect x="300" y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d"/>
          <rect x="440" y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d"/>
          <rect x="580" y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d"/>
          <rect x="680" y="270" width="120" height="36" rx="6" fill="#0f1923" stroke="#1e2d3d" opacity=".4"/>
          <text x="80"  y="284" text-anchor="middle" fill="#0ef" font-size="8">TX A</text>
          <text x="80"  y="296" text-anchor="middle" fill="#5a7185" font-size="7">a1b2c3d4…</text>
