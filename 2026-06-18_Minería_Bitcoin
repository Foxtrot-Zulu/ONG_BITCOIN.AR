<script>
  const slides = [...document.querySelectorAll('.slide')];
  let cur = 0;
  const total = slides.length;

  const axisColors = { intro:'#f7931a', filosofico:'#f7931a', tecnico:'#0ef', economico:'#e8b84b', conclusion:'#f7931a' };
  const axisNames  = { intro:'Introducción', filosofico:'I · Filosófico', tecnico:'II · Técnico', economico:'III · Económico', conclusion:'Conclusión' };

  function goTo(n) {
    slides[cur].classList.remove('active');
    cur = Math.max(0, Math.min(n, total - 1));
    slides[cur].classList.add('active');
    const ax = slides[cur].dataset.axis || 'intro';
    document.getElementById('counter').textContent = `${cur + 1} / ${total}`;
    document.getElementById('axis-label').textContent = axisNames[ax] || ax;
    document.getElementById('axis-label').style.color = axisColors[ax] || '#f7931a';
    document.getElementById('progress').style.width = `${((cur + 1) / total) * 100}%`;
    document.getElementById('progress').style.background = axisColors[ax] || '#f7931a';
  }

  document.getElementById('btn-next').addEventListener('click', () => goTo(cur + 1));
  document.getElementById('btn-prev').addEventListener('click', () => goTo(cur - 1));
  document.addEventListener('keydown', e => {
    if (['ArrowRight','ArrowDown',' '].includes(e.key)) { e.preventDefault(); goTo(cur + 1); }
    if (['ArrowLeft','ArrowUp'].includes(e.key))        { e.preventDefault(); goTo(cur - 1); }
  });
  let tx = 0;
  document.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend',   e => { const dx = tx - e.changedTouches[0].clientX; if (Math.abs(dx) > 50) goTo(dx > 0 ? cur + 1 : cur - 1); });

  // Animate cover hash
  const hashEl = document.getElementById('live-hash');
  const chars = '0123456789abcdef';
  const rH = l => Array.from({length:l}, () => chars[Math.floor(Math.random()*chars.length)]).join('');
  setInterval(() => {
    if (cur !== 0) return;
    hashEl.innerHTML = `<span class="valid">000000000000000000</span>${rH(46)}<br>${rH(58)}<br>${rH(58)}`;
  }, 100);

  goTo(0);
</script>
